{
  "name": "engine-sound-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Procedural engine sound simulator web application",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "check": "prettier --check . && markdownlint-cli2 '**/*.md' '#node_modules' && npm run check:tickets && npm run test:tooling && npm run lint && npm run typecheck",
    "check:tickets": "node scripts/tickets.mjs check",
    "dev": "vite",
    "lint": "eslint .",
    "test:tooling": "node --test scripts/tickets.test.mjs",
    "format": "prettier --write .",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
